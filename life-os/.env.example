# =========================================================
# LIFE OS — Version 1 Environment Variables
# =========================================================
#
# IMPORTANT:
# This file contains variable names only.
#
# NEVER place real passwords, API keys, tokens or private
# credentials in this file.
#
# Real local values belong in:
#
# .env.local
#
# Production values belong in:
#
# Vercel Environment Variables
#
# =========================================================
# ---------------------------------------------------------
# Supabase
# Browser-safe public project configuration.
# Authorization is enforced through authentication + RLS.
# ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ---------------------------------------------------------
# OpenAI
# SERVER ONLY.
#
# Never expose this variable to browser/client code.
# Never rename it with the NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------
OPENAI_API_KEY=