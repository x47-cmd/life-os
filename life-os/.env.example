# =========================================================
# LIFE OS — Environment Variables
# =========================================================
#
# IMPORTANT:
#
# This file contains VARIABLE NAMES ONLY.
#
# NEVER place real:
#
# passwords
# API keys
# tokens
# database credentials
# private secrets
#
# in this file.
#
#
# Local development values belong in:
#
# .env.local
#
#
# Production values belong in:
#
# Vercel Environment Variables
#
# =========================================================


# ---------------------------------------------------------
# Supabase
# ---------------------------------------------------------
#
# Browser-safe public project configuration.
#
# These values are intentionally public.
#
# Authorization is enforced through:
#
# authenticated session
# +
# PostgreSQL RLS
# +
# Storage RLS
#
# ---------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ---------------------------------------------------------
# OpenAI
# ---------------------------------------------------------
#
# SERVER ONLY.
#
# Used by LIFE AI and controlled AI features.
#
# Never expose this variable to browser/client code.
#
# Never rename it with the NEXT_PUBLIC_ prefix.
#
# ---------------------------------------------------------

OPENAI_API_KEY=


# ---------------------------------------------------------
# Twelve Data
# ---------------------------------------------------------
#
# SERVER ONLY.
#
# Used by LIFE Invest AI for:
#
# market prices
# historical time series
# fundamentals
# company market evidence
#
#
# Never expose this variable to browser/client code.
#
# Never rename it with the NEXT_PUBLIC_ prefix.
#
#
# Real value belongs only in:
#
# .env.local
#
# or
#
# Vercel Environment Variables
#
# ---------------------------------------------------------

TWELVE_DATA_API_KEY=


# =========================================================
# SECRET BOUNDARY
# =========================================================
#
# Browser-safe:
#
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#
#
# Server-only:
#
# OPENAI_API_KEY
# TWELVE_DATA_API_KEY
#
#
# NEVER add:
#
# SUPABASE_SERVICE_ROLE_KEY
# database password
# broker API credentials
# bank credentials
#
# to the LIFE OS application runtime unless the security
# architecture is explicitly redesigned and reviewed.
#
# =========================================================