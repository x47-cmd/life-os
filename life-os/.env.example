# =========================================================
# LIFE OS — Environment Variables
# =========================================================
#
# This file contains variable names only.
#
# Never place real passwords, API keys, tokens,
# credentials, or private secrets in this file.
#
# Local development values belong in:
#
# .env.local
#
# Production values belong in:
#
# Vercel Environment Variables
#
# =========================================================


# ---------------------------------------------------------
# Supabase
# ---------------------------------------------------------
#
# Browser-safe public project configuration.
#
# Authorization is enforced through:
#
# authenticated session
# +
# PostgreSQL RLS
# +
# Storage RLS
#
# ---------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ---------------------------------------------------------
# OpenAI
# ---------------------------------------------------------
#
# SERVER ONLY.
#
# Used by LIFE AI and controlled AI features.
#
# Never expose this variable to browser/client code.
# Never rename it with the NEXT_PUBLIC_ prefix.
#
# ---------------------------------------------------------

OPENAI_API_KEY=


# ---------------------------------------------------------
# Twelve Data
# ---------------------------------------------------------
#
# SERVER ONLY.
#
# Used by LIFE Invest AI for:
#
# market prices
# historical time series
# fundamentals
# verified market evidence
#
# Never expose this variable to browser/client code.
# Never rename it with the NEXT_PUBLIC_ prefix.
#
# ---------------------------------------------------------

TWELVE_DATA_API_KEY=


# =========================================================
# SECRET BOUNDARY
# =========================================================
#
# Browser-safe:
#
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#
# Server-only:
#
# OPENAI_API_KEY
# TWELVE_DATA_API_KEY
#
# Sensitive administrative credentials must never be added
# to the LIFE OS application runtime or source control.
#
# =========================================================